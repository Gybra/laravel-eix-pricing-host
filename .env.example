APP_NAME="Laravel EIX Pricing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

CACHE_STORE=database
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

EIX_DB_CONNECTION=
EIX_STORAGE_DISK=local
EIX_STORAGE_PREFIX=eix
EIX_IMPORT_LOCK_STORE=database
EIX_SCHEDULE_ENABLED=true
EIX_SCHEDULE_ON_ONE_SERVER=false
EIX_ROUTES_ENABLED=true
EIX_ROUTES_PREFIX=api
EIX_ROUTES_THROTTLE=60,1
