APP_NAME="Laravel EIX Pricing"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_URL=
DB_SSLMODE=require

CACHE_STORE=database
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

EIX_DB_CONNECTION=pgsql
EIX_STORAGE_DISK=s3
EIX_STORAGE_PREFIX=eix
EIX_IMPORT_LOCK_STORE=database
EIX_SCHEDULE_ENABLED=true
EIX_SCHEDULE_ON_ONE_SERVER=true
EIX_ROUTES_ENABLED=true
EIX_ROUTES_PREFIX=api
EIX_ROUTES_THROTTLE=60,1
